{
  "name": "timer-for-work",
  "displayName": "Timer for work",
  "description": "Таймер работы и отдыха для VS code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "timer-for-work.start",
        "title": "Timer for work: Старт / продолжить"
      },
      {
        "command": "timer-for-work.pause",
        "title": "Timer for work: Пауза"
      },
      {
        "command": "timer-for-work.stop",
        "title": "Timer for work: Сброс"
      },
      {
        "command": "timer-for-work.setIntervals",
        "title": "Timer for work: Настроить интервалы"
      },
      {
        "command": "timer-for-work.showStats",
        "title": "Timer for work: Статистика по проектам"
      }
    ],
    "configuration": {
      "title": "Timer for work",
      "properties": {
        "timerForWork.workMinutes": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "description": "Длительность работы (в минутах)"
        },
        "timerForWork.breakMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Длительность отдыха (в минутах)"
        },
        "timerForWork.idleMinutes": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Через сколько минут без действий таймер встанет на паузу"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
